  triclinic box = (0.0043505722 -0.0022677596 -0.0042167688) to (17.240648 17.247267 17.249216) with tilt (1.0562294e-15 -6.901373e-05 1.0564681e-15)
if "${dir} == 6" then "change_box all xy delta ${delta} remap units box"

