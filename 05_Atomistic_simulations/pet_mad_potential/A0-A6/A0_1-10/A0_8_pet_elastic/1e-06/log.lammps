  triclinic box = (0.0010559073 0.00049388068 -0.0015937075) to (17.243943 17.244505 17.246593) with tilt (1.0558912e-15 -1.7248186e-05 1.0561468e-15)
if "${dir} == 6" then "change_box all xy delta ${delta} remap units box"

