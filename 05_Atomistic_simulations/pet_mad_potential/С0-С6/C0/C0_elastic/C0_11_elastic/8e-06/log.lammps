  triclinic box = (-0.011615444 -0.025955438 -0.019791948) to (17.361615 17.375955 17.369931) with tilt (1.0655597e-15 1.0648049e-15 1.0648049e-15)
if "${dir} == 4" then "change_box all yz delta ${delta} remap units box"
if "${dir} == 5" then "change_box all xz delta ${delta} remap units box"
if "${dir} == 6" then "change_box all xy delta ${delta} remap units box"

minimize ${etol} ${ftol} ${maxiter} ${maxeval}
minimize 1e-08 ${ftol} ${maxiter} ${maxeval}
minimize 1e-08 1e-12 ${maxiter} ${maxeval}
minimize 1e-08 1e-12 0 ${maxeval}
