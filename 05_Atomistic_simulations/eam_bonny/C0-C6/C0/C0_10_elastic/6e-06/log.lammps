include init.mod
variable up equal 6e-06
variable atomjiggle equal 1.0e-5
units metal
variable cfac equal 1.0e-4
variable cunits string GPa
variable etol equal 1.0e-8
variable ftol equal 1.0e-12
variable maxiter equal 0.0
variable maxeval equal 50000
variable dmax equal 1.0e-2
boundary p p p
read_data C0_10_minimized.data
Reading data file ...
  triclinic box = (0.0098140022 0.0050442415 -0.0062931466) to (17.590186 17.594956 17.606293) with tilt (1.0770714e-15 1.0784599e-15 1.0784599e-15)
  1 by 2 by 2 MPI processor grid
  reading atoms ...
  500 atoms
  reading velocities ...
  500 velocities
  read_data CPU = 0.005 seconds
mass 1 58.6934 # Ni
mass 2 55.845  # Fe
mass 3 51.9961 # Cr
include potential.mod
pair_style eam/alloy
pair_coeff * * FeNiCr_bonny.eam.alloy Ni Fe Cr
neighbor 2.0 bin
neigh_modify delay 0 check yes
min_style cg
min_modify dmax ${dmax} line quadratic
min_modify dmax 0.01 line quadratic
thermo 1
thermo_style custom step temp pe press pxx pyy pzz pxy pxz pyz lx ly lz vol
thermo_modify norm no
fix 3 all box/relax aniso 0.0
minimize ${etol} ${ftol} ${maxiter} ${maxeval}
minimize 1e-08 ${ftol} ${maxiter} ${maxeval}
minimize 1e-08 1e-12 ${maxiter} ${maxeval}
minimize 1e-08 1e-12 0 ${maxeval}
minimize 1e-08 1e-12 0 50000

